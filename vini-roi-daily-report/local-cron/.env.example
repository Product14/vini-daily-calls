# ── ROI Email local cron ── copy to .env (gitignored), fill, then: npm i && npm run loop

# ROI Supabase (service_role — writes roi_digest_runs, bypasses RLS)
ROI_SUPABASE_URL=https://pbhrglcpwhevrttipctk.supabase.co
ROI_SUPABASE_SERVICE_KEY=eyJ...service_role...

# ── Data source ──
# 'metabase-embed' (signed JWT, DEFAULT) | 'metabase' (public card) | 'clickhouse'
EMBEDDING_TYPE=metabase-embed
# Signed embedding (the 3 questions; cards in db/clickhouse-endpoints/metabase-*.sql)
METABASE_SITE_URL=https://metabase.spyne.ai
METABASE_SECRET_KEY=<your-metabase-embedding-secret>
METABASE_METRICS_QUESTION=12215
METABASE_ACTION_QUESTION=12216
METABASE_CAMPAIGNS_QUESTION=12217
# (public-card alt — only if EMBEDDING_TYPE=metabase)
# EMBEDDING_URL=
# ACTION_ITEMS_EMBEDDING_URL=
# CAMPAIGNS_EMBEDDING_URL=
# clickhouse alt: set EMBEDDING_TYPE=clickhouse, EMBEDDING_URL=<query-endpoint run url>, and:
# CLICKHOUSE_KEY_ID=
# CLICKHOUSE_KEY_SECRET=

# Mail (the shared curl). Proxy currently accepts unauthenticated POSTs; set MAIL_TOKEN only if needed.
MAIL_PROXY_URL=https://mail.spyne.ai/api/v1/send-template-email
MAIL_TEMPLATE=email-control-tower-report
# MAIL_TOKEN=

# SAFETY: true (default) = render + record 'suppressed/dry_run', send NOTHING.
# Set false to actually email. A rooftop with dry_run=true is held even when this is false.
DRY_RUN=true
# Action-items card (db/clickhouse-endpoints/metabase-action-items.sql) — intent breakdown.
ACTION_ITEMS_EMBEDDING_URL=
