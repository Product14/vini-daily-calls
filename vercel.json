{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/scheduled-report", "schedule": "30 6 * * *"  },
    { "path": "/api/scheduled-report", "schedule": "30 12 * * *" },
    { "path": "/api/scheduled-report", "schedule": "30 18 * * *" },
    { "path": "/api/cron/roi-email",   "schedule": "0 * * * *"   },
    { "path": "/api/cron/roi-events",  "schedule": "*/4 0-2,12-23 * * *" },
    { "path": "/api/cron/roi-events",  "schedule": "*/15 3-11 * * *" },
    { "path": "/api/cron/agents-refresh", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/csm-sync",       "schedule": "0 6 * * *"    },
    { "path": "/api/cron/sync-live",   "schedule": "0 5 * * *"   },
    { "path": "/api/cron/sync-lifecycle", "schedule": "10 5 * * *" }
  ]
}
