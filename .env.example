# Local API: copy this file to `database_url.env` or `.env` in the repo root (both are gitignored).
# The server loads `database_url.env` first if it exists.

# Supabase project: https://supabase.com/dashboard/project/tzzruzwuvurcrwpdwnkz
# API URL (public — safe to commit in examples; keys are not)
SUPABASE_URL=https://tzzruzwuvurcrwpdwnkz.supabase.co
# Project Settings → API → service_role (server-only; used for Vini deployment_statuses table)
# SUPABASE_SECRET_KEY=

# Supabase PostgreSQL connection string (required — set in Vercel environment variables)
# Use the "Transaction" mode pooler URL (port 6543) for Vercel serverless:
#   Supabase dashboard → Project → Connect → Transaction mode
# Same project — paste the full "Transaction pooler" URI from Connect (do not commit real passwords).
# VIN_TRACKER_DATABASE_URL=postgresql://postgres.tzzruzwuvurcrwpdwnkz:[YOUR-PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres
VIN_TRACKER_DATABASE_URL=

# Optional: override API base URL (leave unset — frontend and backend are co-deployed on Vercel)
# VITE_API_URL=

# Vini Account Health — Metabase public card JSON (same export columns as vini-dashboard CSV import).
# Fetched automatically on each POST /api/sync (Refresh) with VIN data. Example path: /api/public/card/<uuid>/query/json
# VINI_ROOFTOP_METABASE_URL=https://metabase.spyne.ai/api/public/card/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/query/json

# ─── /programs (Account Programs · Path to Green) ───────────────────────────
# Separate Supabase project used as the program-management backend (tasks,
# DRIs, diagnoses). Publishable key is client-safe; RLS is disabled on the two
# programs_* tables for first-cut. Run src/programs/schema.sql once in the
# Supabase SQL editor to create the tables.
VITE_PROGRAMS_SUPABASE_URL=https://zocdmtehlfeozrtitmej.supabase.co
VITE_PROGRAMS_SUPABASE_KEY=sb_publishable_71TOgS-eKBNL-x4zpspV4Q_JyZn6Hx6

# Email delivery for the Daily Snapshot — Spyne's internal Mailgun proxy.
# The proxy currently accepts unauthenticated POSTs. If that changes,
# uncomment EMAIL_PROXY_COOKIE and paste a sails.sid value.
EMAIL_PROXY_URL=https://mail.spyne.ai/api/v1/send-template-email
EMAIL_PROXY_TEMPLATE=email-control-tower-report
# EMAIL_PROXY_COOKIE=

# ─── /email-tracker (ROI Email Tracker tab) ─────────────────────────────────
# ROI Supabase project (roi_* tables: digest runs, live departments, config,
# recipients). Publishable/anon key is client-safe. When unset, the tab shows
# mock data. Reads only — writes (dry-run / send-now) go through the send server.
VITE_ROI_SUPABASE_URL=https://qludnojfibguobgeeujw.supabase.co
VITE_ROI_SUPABASE_KEY=sb_publishable_lAj9Qkqai-MG9c0S9t6cHw_DZyK42Bl
# Server-side (POST /api/email/roi-send-now): marks the run sent in roi_digest_runs.
# ROI Supabase project. service_role key (server-only, bypasses RLS). Without it,
# "Send now" still emails but the run is NOT marked sent in the DB.
ROI_SUPABASE_URL=https://qludnojfibguobgeeujw.supabase.co
# ROI_SUPABASE_SERVICE_KEY=eyJ... (Project Settings → API → service_role)
# Mail proxy for "Send now" (already defined above as EMAIL_PROXY_URL / EMAIL_PROXY_TEMPLATE).

# Dry-run flag for cron senders (roi-cron / digests): "1" builds but does not send.
DRY_RUN=0

# ─── Control Tower (controlTower/ — daily Slack + leadership email) ──────────
# The control tower's agent-performance numbers come from the SAME ClickHouse
# conversation spine the dashboard uses (server/agentRooftop.js), so it needs
# the prod ClickHouse creds below. Funnel/ARR still come from the Vini Master
# Sheet and call-quality from Superbryn (unchanged).
#
# Prod ClickHouse (read-only) — required for the agent spine (also used by
# server/agentMetrics.js). Already set in the live .env.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Trailing window the spine scan covers (days). Default 120 (server/agentRooftop.js).
# AGENTS_WINDOW_DAYS=120

# Email send (mail.spyne.ai) — service-account sails.sid cookie, not personal.
# Rotate any cookie that lands in chat/logs/commits.
SPYNE_MAIL_COOKIE="sails.sid=s%3A__paste_here__"
SPYNE_MAIL_TEMPLATE="email-control-tower-report"
MAIL_TO="devansh.hasija@spyne.ai"
MAIL_CC="vivek.vishnoi@spyne.ai, mehul.kamra@spyne.ai, subhav.malhotra@spyne.ai, yash.sharma@spyne.ai, lakshya.gaur@spyne.ai, sanjay@spyne.ai, saurabh.shah@spyne.ai, reports@spyne.ai"
MAIL_BCC=""

# Superbryn per-agent quality-eval keys (each scoped to one agent).
SUPERBRYN_KEY_SALES_IB="sbryn_PASTE_HERE"
SUPERBRYN_KEY_SALES_IB_2="sbryn_PASTE_HERE"
SUPERBRYN_KEY_SALES_OB="sbryn_PASTE_HERE"
SUPERBRYN_KEY_SERVICE_IB="sbryn_PASTE_HERE"
SUPERBRYN_KEY_SERVICE_OB="sbryn_PASTE_HERE"

# Vini Master Sheet override (optional; defaults to the ID in viniMasterSheet.js).
# VINI_MASTER_SHEET_ID="15BScfybsSmmvQefXQxN-TYA_-cCNkD8qLDui7EML3ss"

# Slack auto-upload (optional). When set, ct:send:slack posts the PNG via
# files.uploadV2 (bot scopes: files:write + chat:write). Without it the PNG is
# written for manual upload.
# SLACK_BOT_TOKEN="xoxb-..."
# SLACK_CHANNEL="C0123456789"   # channel ID (not name)
