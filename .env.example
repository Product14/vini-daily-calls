# Local API: copy this file to `database_url.env` or `.env` in the repo root (both are gitignored).
# The server loads `database_url.env` first if it exists.

# Supabase project: https://supabase.com/dashboard/project/tzzruzwuvurcrwpdwnkz
# API URL (public — safe to commit in examples; keys are not)
SUPABASE_URL=https://tzzruzwuvurcrwpdwnkz.supabase.co
# Project Settings → API → service_role (server-only; used for Vini deployment_statuses table)
# SUPABASE_SECRET_KEY=

# Supabase PostgreSQL connection string (required — set in Vercel environment variables)
# Use the "Transaction" mode pooler URL (port 6543) for Vercel serverless:
#   Supabase dashboard → Project → Connect → Transaction mode
# Same project — paste the full "Transaction pooler" URI from Connect (do not commit real passwords).
# VIN_TRACKER_DATABASE_URL=postgresql://postgres.tzzruzwuvurcrwpdwnkz:[YOUR-PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres
VIN_TRACKER_DATABASE_URL=

# Optional: override API base URL (leave unset — frontend and backend are co-deployed on Vercel)
# VITE_API_URL=

# Vini Account Health — Metabase public card JSON (same export columns as vini-dashboard CSV import).
# Fetched automatically on each POST /api/sync (Refresh) with VIN data. Example path: /api/public/card/<uuid>/query/json
# VINI_ROOFTOP_METABASE_URL=https://metabase.spyne.ai/api/public/card/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/query/json

# ─── /programs (Account Programs · Path to Green) ───────────────────────────
# Separate Supabase project used as the program-management backend (tasks,
# DRIs, diagnoses). Publishable key is client-safe; RLS is disabled on the two
# programs_* tables for first-cut. Run src/programs/schema.sql once in the
# Supabase SQL editor to create the tables.
VITE_PROGRAMS_SUPABASE_URL=https://zocdmtehlfeozrtitmej.supabase.co
VITE_PROGRAMS_SUPABASE_KEY=sb_publishable_71TOgS-eKBNL-x4zpspV4Q_JyZn6Hx6

# Email delivery for the Daily Snapshot — Spyne's internal Mailgun proxy.
# The proxy currently accepts unauthenticated POSTs. If that changes,
# uncomment EMAIL_PROXY_COOKIE and paste a sails.sid value.
EMAIL_PROXY_URL=https://mail.spyne.ai/api/v1/send-template-email
EMAIL_PROXY_TEMPLATE=email-control-tower-report
# EMAIL_PROXY_COOKIE=

# ─── /email-tracker (ROI Email Tracker tab) ─────────────────────────────────
# ROI Supabase project (roi_* tables: digest runs, live departments, config,
# recipients). Publishable/anon key is client-safe. When unset, the tab shows
# mock data. Reads only — writes (dry-run / send-now) go through the send server.
VITE_ROI_SUPABASE_URL=https://pbhrglcpwhevrttipctk.supabase.co
VITE_ROI_SUPABASE_KEY=sb_publishable_cfRCbDeoHHb6Mv40etZAgQ_28d551SX
# Optional: local "Send now" server (renders + posts to mail.spyne.ai). Defaults to localhost:8787.
# VITE_SEND_SERVER_URL=http://localhost:8787
